<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF6DC" android:textSize="15sp" android:textStyle="bold" android:text="نور"/>
    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:text=""/>
    <TextView android:id="@+id/w_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F3E3B8" android:textSize="13sp" android:text=""/>
</LinearLayout>
